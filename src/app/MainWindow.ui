  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #1e1e1e;
    color: #cccccc;
    font-family: "Segoe UI";
    font-size: 9pt;
}
QMenuBar, QMenu {
    background: #1f1f1f;
    color: #cccccc;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #2a2d2e;
}
QStatusBar {
    background: #007acc;
    color: #ffffff;
}
QFrame#activityBar {
    background: #333333;
    border: none;
}
QFrame#sideBar {
    background: #252526;
    border: none;
    border-right: 1px solid #1b1b1c;
}
QFrame#sideHeader, QFrame#editorHeader, QFrame#panelHeader, QFrame#commandHeader {
    background: #252526;
    border-bottom: 1px solid #1b1b1c;
}
QFrame#selectorBlock, QFrame#stageBox, QFrame#counterBox {
    background: transparent;
    border: none;
    border-bottom: 1px solid #313131;
    border-radius: 0;
}
QFrame#commandPanel {
    background: #252526;
    border-left: 1px solid #1b1b1c;
}
QWidget#editorArea, QWidget#panelArea {
    background: #1e1e1e;
}
QLabel {
    color: #cccccc;
}
QLabel#sideTitle, QLabel#pluginsTitle, QLabel#panelTitle, QLabel#commandTitle {
    color: #bbbbbb;
    font-size: 12px;
    font-weight: 700;
}
QLabel#appTitle, QLabel#editorTitle {
    color: #ffffff;
    font-weight: 700;
}
QLabel#editorSubtitle, QLabel#pluginSummaryLabel,
QLabel#rxCounterLabel, QLabel#txCounterLabel, QLabel#commandSubtitle,
QLabel#stagePhysicalLabel, QLabel#stageProtocolLabel, QLabel#configHintLabel {
    color: #9da5ad;
}
QLabel#statusLabel {
    color: #ffffff;
    background: #3a3d41;
    border: 1px solid #55585d;
    border-radius: 2px;
    min-height: 28px;
    padding: 0 8px;
}
QLabel#stagePhysicalValue, QLabel#stageProtocolValue, QLabel#configTitleLabel {
    color: #ffffff;
    font-weight: 600;
}
QPushButton {
    background: #0e639c;
    color: #ffffff;
    border: 1px solid #1177bb;
    border-radius: 2px;
    font-weight: 600;
    min-height: 28px;
    max-height: 28px;
    min-width: 72px;
    padding: 0 12px;
}
QPushButton:hover {
    background: #1177bb;
}
QPushButton:disabled {
    background: #2d2d30;
    border-color: #3c3c3c;
    color: #6f7378;
}
QPushButton#configButton, QPushButton#saveHistoryButton, QPushButton#loadHistoryButton, QPushButton#clearHistoryButton {
    background: #3c3c3c;
    border-color: #4c4c4c;
}
QPushButton#configButton, QPushButton#disconnectButton {
    min-width: 104px;
}
QPushButton#connectButton {
    min-width: 88px;
}
QPushButton#saveHistoryButton, QPushButton#loadHistoryButton {
    min-width: 104px;
}
QPushButton#clearHistoryButton {
    min-width: 64px;
}
QPushButton#disconnectButton {
    background: #8a3a3a;
    border-color: #a84848;
}
QFrame#activityBar QToolButton {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    color: #d4d4d4;
    min-width: 52px;
    max-width: 52px;
    min-height: 44px;
    max-height: 44px;
    padding: 0;
}
QFrame#activityBar QToolButton:hover {
    background: #2a2d2e;
}
QFrame#activityBar QToolButton[active="true"] {
    color: #ffffff;
    background: #2a2d2e;
    border-left: 2px solid #ffffff;
}
QComboBox, QTreeWidget, QPlainTextEdit, QTableWidget, QTabWidget::pane {
    background: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3c3c3c;
}
QLineEdit, QSpinBox {
    background: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    min-height: 28px;
    max-height: 28px;
    padding-left: 6px;
}
QComboBox {
    min-height: 28px;
    max-height: 28px;
    padding-left: 8px;
    border-radius: 2px;
}
QTreeWidget, QPlainTextEdit, QTableWidget {
    border-left: none;
    border-right: none;
    border-bottom: none;
}
QTableWidget#configTable {
    border: 1px solid #3c3c3c;
    border-radius: 2px;
}
QHeaderView::section {
    background: #252526;
    color: #bbbbbb;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    padding: 5px;
}
QTableWidget::item:selected, QTreeWidget::item:selected {
    background: #094771;
    color: #ffffff;
}
QTabBar::tab {
    background: #2d2d30;
    color: #969696;
    border: none;
    border-right: 1px solid #1b1b1c;
    min-height: 30px;
    padding: 0 14px;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #ffffff;
    border-top: 1px solid #007acc;
}
QSplitter::handle {
    background: #1e1e1e;
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}</string>
